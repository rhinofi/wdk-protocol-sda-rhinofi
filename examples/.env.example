# Copy to examples/.env and fill in. Never commit the copy.
#
# Both examples call the live rhino.fi mainnet API - there is no sandbox.

# Required. A standard key is enough for discover-and-quote.mjs and for creating
# the address in deposit-address.mjs; the getTransfers call at the end of
# deposit-address.mjs needs a SECRET_ key. Keep SECRET_ keys server-side.
RHINO_API_KEY=

# The address the converted funds are delivered to on the destination chain.
RHINO_DESTINATION_ADDRESS=

# discover-and-quote.mjs only: the source-chain address the deposit would come from.
RHINO_DEPOSITOR_ADDRESS=
