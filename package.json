{
  "name": "@rhino.fi/wdk-protocol-sda-rhinofi",
  "version": "1.0.1",
  "description": "WDK module for Rhino.fi Smart Deposit Addresses: generate one address per user and let Rhino.fi handle chain detection, routing and settlement.",
  "keywords": [
    "wdk",
    "protocol",
    "sda",
    "rhinofi"
  ],
  "author": "Rhino.fi",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhinofi/wdk-protocol-sda-rhinofi.git"
  },
  "homepage": "https://github.com/rhinofi/wdk-protocol-sda-rhinofi#readme",
  "bugs": {
    "url": "https://github.com/rhinofi/wdk-protocol-sda-rhinofi/issues"
  },
  "main": "index.js",
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "SECURITY.md",
    "assets",
    "bare.js",
    "index.js",
    "src",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node scripts/strip-internal-types.mjs",
    "build:types": "tsc && node scripts/strip-internal-types.mjs",
    "prepack": "tsc && node scripts/strip-internal-types.mjs",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "dependencies": {
    "@rhino.fi/sdk": "3.3.0",
    "@tetherto/wdk-wallet": "1.0.0-beta.19",
    "bare-node-runtime": "1.5.0",
    "decimal.js": "10.6.0"
  },
  "overrides": {
    "axios": "1.20.0",
    "uuid": "11.1.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "jest": "29.7.0",
    "standard": "17.1.2",
    "typescript": "5.8.3"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "bare": "./bare.js",
      "default": "./index.js"
    },
    "./package": {
      "default": "./package.json"
    }
  },
  "standard": {
    "ignore": [
      "bare.js",
      "tests/**/*.js"
    ]
  }
}
